# Виртуальное окружение
venv/
env/
.venv/

# Файлы настройки и кэш Python
__pycache__/
*.py[cod]
*$py.class

# База данных SQLite (если используется)
*.sqlite3
*.db

# Переменные окружения и секреты
.env

# Статические файлы и медиа (при загрузке пользователями)
/staticfiles/
/media/

# Настройки IDE (VS Code, PyCharm и др.)
.vscode/
.idea/

# Логи и временные файлы
*.log
.DS_Store